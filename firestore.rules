rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Negação estrita por padrão
    match /{document=**} {
      allow read, write: if false;
    }

    // Endpoint de teste de conectividade (Heartbeat 24/7)
    match /test/connection {
      allow read: if true;
    }

    // Funções utilitárias de validação e segurança
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existingData() {
      return resource.data;
    }

    function isValidPostoDoc(postoId) {
      return incoming() is map
        && incoming().postoId is string
        && incoming().postoId == postoId
        && incoming().postoId.size() <= 64;
    }

    function isValidUserPayload(uid) {
      return incoming() is map
        && incoming().uid is string
        && incoming().uid == uid
        && incoming().uid.size() <= 128
        && incoming().nome is string
        && incoming().nome.size() <= 150
        && incoming().email is string
        && incoming().email.size() <= 200;
    }

    function userHasDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isManager() {
      return userHasDoc() && (currentUserData().role == 'GERENTE' || currentUserData().role == 'ADMINISTRADOR');
    }

    function isPostoMember(postoId) {
      return isAuthenticated() && (
        !userHasDoc() ||
        currentUserData().postoId == postoId ||
        isManager()
      );
    }

    // Coleção de Usuários: Apenas autenticados leem; auto-criação restrita; impede auto-elevação de privilégio
    match /usuarios/{uid} {
      allow get, list: if isAuthenticated();
      // Auto-cadastro: o próprio usuário autenticado cria seu perfil inicial
      allow create: if isUser(uid) && isValidUserPayload(uid);
      // Atualização: o próprio usuário pode atualizar dados cadastrais, MAS não pode alterar o próprio 'role' (privilégio);
      // apenas Gerente/Administrador pode alterar o 'role'.
      allow update: if isValidId(uid) && isValidUserPayload(uid) && (
        (isUser(uid) && incoming().role == existingData().role) ||
        isManager()
      );
      // Exclusão: restrita exclusivamente a gestores
      allow delete: if isValidId(uid) && isManager();
    }

    // Isolamento Multi-tenant: Postos e subcoleções operacionais
    match /postos/{postoId} {
      allow get, list: if isValidId(postoId) && isPostoMember(postoId);
      allow create, update: if isValidId(postoId) && isPostoMember(postoId);
      allow delete: if isValidId(postoId) && isManager();

      // Trilha de Auditoria: Imutabilidade estrita (WORM - Write Once, Read Many)
      // Impedir qualquer exclusão ou adulteração de logs de auditoria
      match /auditoria/{auditoriaId} {
        allow get, list: if isValidId(postoId) && isValidId(auditoriaId) && isPostoMember(postoId);
        allow create: if isValidId(postoId) && isValidId(auditoriaId) && isValidPostoDoc(postoId) && isPostoMember(postoId);
        allow update, delete: if false; // Proibição absoluta de alteração ou apagamento de auditoria
      }

      // Subcoleções operacionais padrão
      match /{subcollection}/{docId} {
        allow get, list: if isValidId(postoId) && isValidId(docId) && isPostoMember(postoId);
        allow create, update: if isValidId(postoId) && isValidId(docId) && isValidPostoDoc(postoId) && isPostoMember(postoId);
        allow delete: if isValidId(postoId) && isValidId(docId) && isPostoMember(postoId);
      }
    }
  }
}
