rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Connection testing endpoint (24/7 Cloud Heartbeat)
    match /test/connection {
      allow read: if true;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidPostoDoc(postoId) {
      return incoming() is map
        && incoming().postoId is string
        && incoming().postoId == postoId
        && incoming().postoId.size() <= 64;
    }

    function isValidUserPayload(uid) {
      return incoming() is map
        && incoming().uid is string
        && incoming().uid == uid
        && incoming().uid.size() <= 128
        && incoming().nome is string
        && incoming().nome.size() <= 150
        && incoming().email is string
        && incoming().email.size() <= 200;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Coleção de Usuários e Acessos na Nuvem 24h
    match /usuarios/{uid} {
      allow get, list: if true;
      allow create, update: if isValidId(uid) && isValidUserPayload(uid);
      allow delete: if isValidId(uid);
    }

    // Multi-tenant: Postos e subcoleções operacionais 24h na nuvem
    match /postos/{postoId} {
      allow get, list: if isValidId(postoId);
      allow create, update: if isValidId(postoId);
      allow delete: if isValidId(postoId);

      // Funcionários
      match /funcionarios/{funcionarioId} {
        allow get, list: if isValidId(postoId);
        allow create, update: if isValidId(postoId) && isValidId(funcionarioId) && isValidPostoDoc(postoId);
        allow delete: if isValidId(postoId) && isValidId(funcionarioId);
      }

      // Escalas e Turnos
      match /escalas/{escalaId} {
        allow get, list: if isValidId(postoId);
        allow create, update: if isValidId(postoId) && isValidId(escalaId) && isValidPostoDoc(postoId);
        allow delete: if isValidId(postoId) && isValidId(escalaId);
      }

      // Escalas Importadas (Imagem Original + OCR + Conferência + Histórico)
      match /escalasImportadas/{importacaoId} {
        allow get, list: if isValidId(postoId);
        allow create, update: if isValidId(postoId) && isValidId(importacaoId) && isValidPostoDoc(postoId);
        allow delete: if isValidId(postoId) && isValidId(importacaoId);
      }

      match /turnos/{turnoId} {
        allow get, list: if isValidId(postoId);
        allow create, update: if isValidId(postoId) && isValidId(turnoId) && isValidPostoDoc(postoId);
        allow delete: if isValidId(postoId) && isValidId(turnoId);
      }

      // Fechamentos de Caixa
      match /fechamentos/{fechamentoId} {
        allow get, list: if isValidId(postoId);
        allow create, update: if isValidId(postoId) && isValidId(fechamentoId) && isValidPostoDoc(postoId);
        allow delete: if isValidId(postoId) && isValidId(fechamentoId);
      }

      // Ocorrências de Caixa
      match /ocorrenciasCaixa/{ocorrenciaId} {
        allow get, list: if isValidId(postoId);
        allow create, update: if isValidId(postoId) && isValidId(ocorrenciaId) && isValidPostoDoc(postoId);
        allow delete: if isValidId(postoId) && isValidId(ocorrenciaId);
      }

      // Rateios de Sobras e Faltas
      match /rateios/{rateioId} {
        allow get, list: if isValidId(postoId);
        allow create, update: if isValidId(postoId) && isValidId(rateioId) && isValidPostoDoc(postoId);
        allow delete: if isValidId(postoId) && isValidId(rateioId);
      }

      // LMC — Livro de Movimentação de Combustíveis
      match /lmc/{lmcId} {
        allow get, list: if isValidId(postoId);
        allow create, update: if isValidId(postoId) && isValidId(lmcId) && isValidPostoDoc(postoId);
        allow delete: if isValidId(postoId) && isValidId(lmcId);
      }

      // Tanques e Réguas
      match /tanques/{tanqueId} {
        allow get, list: if isValidId(postoId);
        allow create, update: if isValidId(postoId) && isValidId(tanqueId) && isValidPostoDoc(postoId);
        allow delete: if isValidId(postoId) && isValidId(tanqueId);
      }

      // Bicos
      match /bicos/{bicoId} {
        allow get, list: if isValidId(postoId);
        allow create, update: if isValidId(postoId) && isValidId(bicoId) && isValidPostoDoc(postoId);
        allow delete: if isValidId(postoId) && isValidId(bicoId);
      }

      // Aferições (Medida Padrão 20L)
      match /afericoes/{afericaoId} {
        allow get, list: if isValidId(postoId);
        allow create, update: if isValidId(postoId) && isValidId(afericaoId) && isValidPostoDoc(postoId);
        allow delete: if isValidId(postoId) && isValidId(afericaoId);
      }

      // Densidades e Termodensímetro (ANP)
      match /densidades/{densidadeId} {
        allow get, list: if isValidId(postoId);
        allow create, update: if isValidId(postoId) && isValidId(densidadeId) && isValidPostoDoc(postoId);
        allow delete: if isValidId(postoId) && isValidId(densidadeId);
      }

      // Análises laboratoriais de combustível
      match /analises/{analiseId} {
        allow get, list: if isValidId(postoId);
        allow create, update: if isValidId(postoId) && isValidId(analiseId) && isValidPostoDoc(postoId);
        allow delete: if isValidId(postoId) && isValidId(analiseId);
      }

      // Conformidade Operacional
      match /conformidades/{conformidadeId} {
        allow get, list: if isValidId(postoId);
        allow create, update: if isValidId(postoId) && isValidId(conformidadeId) && isValidPostoDoc(postoId);
        allow delete: if isValidId(postoId) && isValidId(conformidadeId);
      }

      // Relatórios
      match /relatorios/{relatorioId} {
        allow get, list: if isValidId(postoId);
        allow create, update: if isValidId(postoId) && isValidId(relatorioId) && isValidPostoDoc(postoId);
        allow delete: if isValidId(postoId) && isValidId(relatorioId);
      }

      // Auditoria Operacional
      match /auditoria/{auditoriaId} {
        allow get, list: if isValidId(postoId);
        allow create, update: if isValidId(postoId) && isValidId(auditoriaId) && isValidPostoDoc(postoId);
        allow delete: if isValidId(postoId) && isValidId(auditoriaId);
      }
    }
  }
}
