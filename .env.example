# GEMINI_API_KEY: Required for Gemini AI API calls (e.g. ANP audit, fuel laudo OCR).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Chave da API do OpenRouter para leitura óptica multimodal da imagem da escala.
OPENROUTER_API_KEY=""

# OPENROUTER_MODEL: Modelo multimodal do OpenRouter para análise da imagem da escala (padrão: modelo multimodal gratuito).
OPENROUTER_MODEL="google/gemini-2.0-flash-lite-preview-02-05:free"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
